NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional alternative to NEXT_PUBLIC_SUPABASE_ANON_KEY if your environment uses it
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Server-only key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis – required in production for globally consistent rate limiting
# across Vercel serverless instances. Omit both to use the in-memory fallback
# (suitable for local development only).
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Market data provider used by the trade detail chart.
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# ─── cTrader Open API ────────────────────────────────────────────────────────
# Register your application at https://openapi.ctrader.com (requires manual
# approval from Spotware).  After approval you receive a client ID and secret.
# The redirect URI registered in the portal must match:
#   {NEXT_PUBLIC_APP_URL}/api/connections/ctrader/callback
CTRADER_CLIENT_ID=your-ctrader-client-id
CTRADER_CLIENT_SECRET=your-ctrader-client-secret

# Public base URL of this deployment (no trailing slash).
# Used to build absolute redirect URIs for OAuth callbacks.
NEXT_PUBLIC_APP_URL=https://your-domain.com
